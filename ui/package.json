{
  "name": "@biddaloy/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared React component package consumed by every SchoolManager SPA.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./components": "./src/components/index.ts",
    "./shells": "./src/shells/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./routes": "./src/routes/index.ts",
    "./utils": "./src/utils/index.ts",
    "./i18n": "./src/i18n/index.ts",
    "./pwa": "./src/pwa/index.ts",
    "./api": "./src/api/index.ts",
    "./test": "./src/test/index.ts",
    "./mocks": "./src/test/msw/enable-mocking.ts",
    "./styles": "./src/styles/globals.css",
    "./tailwind": "./tailwind.preset.ts",
    "./eslint-config": "./eslint-config.mjs"
  },
  "scripts": {
    "lint": "tsc -b tsconfig.json && eslint .",
    "check:exports": "node scripts/check-exports.mjs",
    "check:contrast": "node --experimental-strip-types scripts/check-contrast.mjs",
    "check:raw-palette": "node scripts/check-raw-palette.mjs",
    "check:i18n": "node --experimental-strip-types scripts/check-i18n-keys.mjs",
    "check:api-types": "node scripts/check-api-types.mjs",
    "api:types": "npx --yes openapi-typescript@7.13.0 ../server/openapi.json -o src/api/schema.d.ts",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "design-sync:css": "storybook build -o ../.design-sync/sb-reference && node scripts/sync-design-css.mjs"
  },
  "dependencies": {
    "@biddaloy/shared": "0.1.0",
    "@hookform/resolvers": "^5",
    "@sentry/react": "^10.74.0",
    "@tanstack/react-query": "^5.105.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^9",
    "axios": "^1.21.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4",
    "i18next": "^26",
    "i18next-resources-to-backend": "^1",
    "lucide-react": "^1.66",
    "qrcode": "^1",
    "radix-ui": "^1.8.1",
    "react-hook-form": "^7",
    "react-i18next": "^17",
    "react-router": "^8.5.1",
    "slate": "0.147.4",
    "slate-dom": "0.147.3",
    "slate-history": "0.144.0",
    "slate-react": "0.147.5",
    "sonner": "^2",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10",
    "@storybook/addon-docs": "^10",
    "@storybook/react-vite": "^10",
    "@tailwindcss/vite": "^4",
    "@types/node": "^26",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "axios-mock-adapter": "^2.1.0",
    "eslint-plugin-storybook": "^10",
    "fake-indexeddb": "^6.2.7",
    "msw": "^2",
    "msw-storybook-addon": "^3.0.3",
    "react": "^19",
    "react-dom": "^19",
    "storybook": "^10",
    "typescript": "^6",
    "vite": "^8",
    "vitest": "^4"
  }
}
